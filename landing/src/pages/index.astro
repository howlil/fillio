---
import BaseLayout from '../layouts/BaseLayout.astro';

const productDelta = [
  ['Retype experience on every form', 'Reuse one career profile'],
  ['Copy answers between applications', 'Review prepared reusable answers'],
  ['Remember which document fits the role', 'Use local document recommendations'],
  ['Track opportunities somewhere else', 'Save the current job to a local pipeline'],
];

const showcaseSteps = [
  {
    id: 'detect',
    number: '01',
    title: 'Detect the application',
    text: 'Jobflow recognizes supported application forms and classifies the fields on the page before anything is written.',
  },
  {
    id: 'review',
    number: '02',
    title: 'Surface what needs judgment',
    text: 'Ready, ambiguous, unknown, and sensitive fields are separated so uncertain data never disappears behind automation.',
  },
  {
    id: 'fill',
    number: '03',
    title: 'Fill only approved values',
    text: 'One explicit action writes the safe fields. Unknown and sensitive fields stay untouched until you decide otherwise.',
  },
  {
    id: 'track',
    number: '04',
    title: 'Keep the opportunity',
    text: 'Save the role to the local pipeline and mark it applied only after you submit on the employer site.',
  },
];

const capabilityRows = [
  {
    title: 'Autofill',
    meta: '14 ready · 3 review · 1 sensitive',
    detail: 'Page analysis, Application Profile recommendation, answer memory, and explicit document attachment.',
  },
  {
    title: 'Pipeline',
    meta: 'Current role · local lifecycle',
    detail: 'Capture the exact opportunity and update its status without creating a second tracking surface.',
  },
  {
    title: 'Sensitive',
    meta: 'Encrypted vault · site approval',
    detail: 'Sensitive values remain behind the local vault and require a separate current-site disclosure decision.',
  },
  {
    title: 'Application Profiles',
    meta: 'Role-aware · deterministic',
    detail: 'Use lightweight profile variants chosen from local role, seniority, domain, and skill evidence.',
  },
];

const worksToday = [
  'Chromium desktop',
  'Native and ATS-shaped forms',
  'Dynamic / multi-step forms',
  'PDF, DOCX, and TXT CV import',
  'Resume, cover letter, portfolio, transcript, and certificate fields',
  'Reusable answers and Autofill Memory',
  'Encrypted sensitive-data vault',
  'Local application pipeline',
];

const intentionallyNotSupported = [
  'Auto-submit or auto-next',
  'Cloud career profile',
  'AI dependency for core matching',
  'Image-only PDF extraction',
  'Guessing unknown or ambiguous fields',
];

const dataPaths = [
  ['Career profile', 'Local extension storage'],
  ['Documents', 'Extension-owned IndexedDB'],
  ['Sensitive values', 'Encrypted local vault'],
  ['Application page', 'Analyzed locally'],
  ['AI API', 'None'],
  ['Cloud backend', 'None'],
  ['Submit / Next', 'Never clicked'],
];
---

<BaseLayout
  title="Jobflow — Stop retyping job applications"
  description="Keep one local career profile, review what Jobflow detects, fill only approved fields, and submit job applications yourself."
>
  <header class="sticky top-0 z-50 border-b border-border bg-background/95">
    <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between px-5 lg:px-7">
      <a href="#top" class="flex items-center gap-2.5 text-sm font-semibold tracking-[-0.02em] text-ink" aria-label="Jobflow home">
        <span class="grid size-8 place-items-center rounded-md border border-border-strong bg-ink text-xs font-bold text-background">J</span>
        <span>Jobflow</span>
      </a>

      <nav class="hidden items-center gap-7 text-sm text-muted md:flex" aria-label="Primary navigation">
        <a class="transition-colors hover:text-ink" href="#showcase">Showcase</a>
        <a class="transition-colors hover:text-ink" href="#capabilities">Product</a>
        <a class="transition-colors hover:text-ink" href="#trust">Trust</a>
      </nav>

      <a
        class="premium-button inline-flex h-9 items-center justify-center rounded-md border border-border-strong px-3.5 text-sm font-medium text-ink"
        href="https://github.com/howlil/jobflow"
        target="_blank"
        rel="noreferrer"
      >
        GitHub <span aria-hidden="true" class="ml-1.5">↗</span>
      </a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="relative overflow-hidden border-b border-border">
      <div class="hero-lines" aria-hidden="true"></div>
      <div class="mx-auto grid min-h-[760px] max-w-[1200px] gap-14 px-5 pb-16 pt-20 lg:grid-cols-[0.78fr_1.22fr] lg:items-center lg:px-7 lg:pb-24 lg:pt-24">
        <div class="relative z-10">
          <p class="hero-enter mb-5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-subtle" style="--hero-delay: 60ms">
            Local-first job application workspace
          </p>
          <h1 class="hero-enter max-w-[11ch] text-[clamp(3rem,6vw,5.4rem)] font-semibold leading-[0.92] tracking-[-0.065em] text-ink" style="--hero-delay: 120ms">
            Stop retyping every job application.
          </h1>
          <p class="hero-enter mt-7 max-w-[580px] text-[17px] leading-7 text-muted" style="--hero-delay: 200ms">
            Keep one reusable career profile. Jobflow prepares safe fields for the application you are on, flags what needs review, and never submits for you.
          </p>

          <div class="hero-enter mt-8 flex flex-wrap items-center gap-3" style="--hero-delay: 280ms">
            <a
              class="premium-button inline-flex h-10 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-background"
              href="https://github.com/howlil/jobflow#local-development"
              target="_blank"
              rel="noreferrer"
            >
              Build & install Jobflow <span aria-hidden="true" class="ml-1.5">↗</span>
            </a>
            <a
              class="premium-button inline-flex h-10 items-center justify-center rounded-md border border-border-strong px-4 text-sm font-medium text-ink"
              href="https://github.com/howlil/jobflow"
              target="_blank"
              rel="noreferrer"
            >
              View source
            </a>
          </div>

          <div class="hero-enter mt-7 flex flex-wrap gap-x-5 gap-y-2 text-xs text-subtle" style="--hero-delay: 340ms">
            <span>Local-first</span>
            <span>No account</span>
            <span>No auto-submit</span>
            <span>No AI dependency</span>
          </div>
        </div>

        <div class="hero-enter relative z-10 lg:pl-3" style="--hero-delay: 180ms">
          <div class="premium-stage-wrap" data-parallax-stage>
            <div class="premium-stage" aria-label="Jobflow product showcase">
              <div class="flex h-12 items-center justify-between border-b border-border px-4 sm:px-5">
                <div class="flex items-center gap-2" aria-hidden="true">
                  <span class="size-2.5 rounded-full border border-border-strong"></span>
                  <span class="size-2.5 rounded-full border border-border-strong"></span>
                  <span class="size-2.5 rounded-full border border-border-strong"></span>
                </div>
                <div class="flex min-w-0 items-center gap-2 rounded-md border border-border px-3 py-1.5 font-mono text-[11px] text-subtle">
                  <span class="size-1.5 shrink-0 rounded-full bg-success"></span>
                  <span class="truncate">jobs.example.com/apply/backend-engineer</span>
                </div>
                <span class="w-[52px]"></span>
              </div>

              <div class="relative min-h-[570px] overflow-hidden p-5 sm:p-7">
                <div class="max-w-[62%] sm:max-w-[66%]">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="text-sm font-semibold text-ink">Senior Backend Engineer</p>
                      <p class="mt-1 text-xs text-subtle">Application · Step 2 of 4</p>
                    </div>
                    <span class="hidden rounded-md border border-border px-2 py-1 font-mono text-[10px] text-subtle sm:inline-flex">Workday-like</span>
                  </div>

                  <div class="mt-7 space-y-5" aria-hidden="true">
                    <div>
                      <div class="mb-2 flex items-center justify-between"><div class="h-2.5 w-24 rounded-sm bg-accent-soft"></div><span class="size-1.5 rounded-full bg-success"></span></div>
                      <div class="h-10 rounded-md border border-border bg-surface"></div>
                    </div>
                    <div>
                      <div class="mb-2 flex items-center justify-between"><div class="h-2.5 w-32 rounded-sm bg-accent-soft"></div><span class="size-1.5 rounded-full bg-success"></span></div>
                      <div class="h-10 rounded-md border border-border bg-surface"></div>
                    </div>
                    <div>
                      <div class="mb-2 flex items-center justify-between"><div class="h-2.5 w-28 rounded-sm bg-accent-soft"></div><span class="size-1.5 rounded-full bg-warning"></span></div>
                      <div class="h-10 rounded-md border border-border bg-surface"></div>
                    </div>
                    <div>
                      <div class="mb-2 flex items-center justify-between"><div class="h-2.5 w-36 rounded-sm bg-accent-soft"></div><span class="size-1.5 rounded-full bg-subtle"></span></div>
                      <div class="h-28 rounded-md border border-border bg-surface"></div>
                    </div>
                  </div>
                </div>

                <div class="assistant-float absolute bottom-5 right-4 w-[min(390px,calc(100%-2rem))] overflow-hidden rounded-[10px] border border-border-strong bg-surface-raised shadow-[0_18px_50px_rgb(0_0_0/0.16)] sm:bottom-7 sm:right-7">
                  <div class="flex h-11 items-center justify-between border-b border-border px-4">
                    <div class="flex items-center gap-2">
                      <span class="grid size-6 place-items-center rounded-md bg-ink text-[10px] font-bold text-background">J</span>
                      <div>
                        <p class="text-xs font-semibold text-ink">Jobflow</p>
                        <p class="font-mono text-[10px] text-subtle">18 fields detected</p>
                      </div>
                    </div>
                    <span class="flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-success"></span>ready</span>
                  </div>

                  <div class="grid grid-cols-3 border-b border-border text-center text-xs font-medium">
                    <span class="border-r border-border bg-surface-muted px-2 py-2.5 text-ink">Autofill</span>
                    <span class="border-r border-border px-2 py-2.5 text-muted">Pipeline</span>
                    <span class="px-2 py-2.5 text-muted">Sensitive</span>
                  </div>

                  <div class="p-4">
                    <div class="flex items-start justify-between gap-3 border-b border-border pb-3">
                      <div>
                        <p class="text-sm font-medium text-ink">Backend profile</p>
                        <p class="mt-0.5 text-xs text-subtle">Recommended from role signals</p>
                      </div>
                      <span class="rounded-md border border-border px-2 py-1 font-mono text-[10px] text-subtle">92% fit</span>
                    </div>

                    <div class="grid grid-cols-3 divide-x divide-border border-b border-border py-3 text-center">
                      <div><p class="font-mono text-lg font-semibold text-ink">14</p><p class="mt-0.5 text-[11px] text-subtle">Ready</p></div>
                      <div><p class="font-mono text-lg font-semibold text-warning">3</p><p class="mt-0.5 text-[11px] text-subtle">Review</p></div>
                      <div><p class="font-mono text-lg font-semibold text-muted">1</p><p class="mt-0.5 text-[11px] text-subtle">Sensitive</p></div>
                    </div>

                    <div class="mt-3 space-y-2">
                      <div class="flex items-center justify-between text-xs"><span class="text-muted">First name</span><span class="font-mono text-[10px] text-success">ready</span></div>
                      <div class="flex items-center justify-between text-xs"><span class="text-muted">Current role</span><span class="font-mono text-[10px] text-warning">review</span></div>
                    </div>

                    <div class="mt-4 flex items-center justify-between gap-3 border-t border-border pt-3">
                      <p class="max-w-[170px] text-[11px] leading-4 text-subtle">Unknown and sensitive fields stay untouched.</p>
                      <button type="button" class="h-9 shrink-0 rounded-md bg-accent px-3 text-xs font-medium text-background">Fill 14 safe fields</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="stage-caption absolute -bottom-4 left-5 hidden items-center gap-3 rounded-md border border-border-strong bg-surface-raised px-3 py-2 font-mono text-[10px] text-subtle shadow-[0_10px_30px_rgb(0_0_0/0.1)] sm:flex">
              <span class="size-1.5 rounded-full bg-success"></span>
              user-triggered fill · no submit automation
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1200px] divide-y divide-border px-5 lg:grid-cols-4 lg:divide-x lg:divide-y-0 lg:px-7">
        {['One profile', 'Explicit review', 'Local data', 'You submit'].map((label, index) => (
          <div class="flex items-center gap-3 py-4 lg:px-5 lg:first:pl-0">
            <span class="font-mono text-[10px] text-subtle">0{index + 1}</span>
            <span class="text-sm font-medium text-ink">{label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-[1200px] px-5 py-20 lg:px-7 lg:py-24" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="font-mono text-xs text-subtle">THE PRODUCT DELTA</p>
          <h2 class="mt-4 max-w-[11ch] text-3xl font-semibold tracking-[-0.04em] text-ink sm:text-4xl">Remove repetition. Keep judgment.</h2>
        </div>

        <div class="border-t border-border">
          {productDelta.map(([before, after]) => (
            <div class="grid gap-3 border-b border-border py-5 sm:grid-cols-[1fr_34px_1fr] sm:items-center sm:gap-5">
              <p class="text-sm leading-6 text-muted">{before}</p>
              <span class="hidden text-center font-mono text-xs text-subtle sm:block">→</span>
              <p class="text-sm font-medium leading-6 text-ink">{after}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-border bg-surface">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-20 lg:grid-cols-2 lg:px-7 lg:py-24" data-reveal>
        <div class="border-t border-border pt-5">
          <span class="font-mono text-xs text-subtle">SET UP ONCE</span>
          <h2 class="mt-4 text-2xl font-semibold tracking-[-0.035em] text-ink">Build your reusable career context.</h2>
          <p class="mt-4 max-w-xl text-sm leading-6 text-muted">Experience, education, projects, documents, reusable answers, preferences, and lightweight Application Profiles live in one local workspace.</p>
        </div>

        <div class="border-t border-border pt-5">
          <span class="font-mono text-xs text-subtle">EVERY APPLICATION</span>
          <h2 class="mt-4 text-2xl font-semibold tracking-[-0.035em] text-ink">Use the same controlled loop.</h2>
          <div class="mt-5 flex flex-wrap items-center gap-2 text-xs font-medium text-ink">
            {['Open', 'Detect', 'Review', 'Fill', 'Submit yourself', 'Track'].map((step, index, list) => (
              <>
                <span class="rounded-md border border-border-strong px-2.5 py-1.5">{step}</span>
                {index < list.length - 1 && <span class="font-mono text-subtle">→</span>}
              </>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="showcase" class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-20 lg:px-7 lg:py-28">
        <div class="mb-14 max-w-2xl" data-reveal>
          <p class="font-mono text-xs text-subtle">PRODUCT SHOWCASE</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-[-0.045em] text-ink sm:text-4xl">See the decision boundary, not a fake automation demo.</h2>
          <p class="mt-5 text-[15px] leading-7 text-muted">Scroll through the real interaction model. Jobflow automates repetitive entry while leaving ambiguity, disclosure, and submission visible to you.</p>
        </div>

        <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr]" data-showcase-root data-active-state="detect">
          <div class="space-y-0">
            {showcaseSteps.map((step, index) => (
              <article
                class="showcase-step border-t border-border py-8 last:border-b"
                data-showcase-step={step.id}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <div class="flex items-start gap-4">
                  <span class="mt-1 font-mono text-xs text-subtle">{step.number}</span>
                  <div>
                    <h3 class="text-lg font-semibold tracking-[-0.025em] text-ink">{step.title}</h3>
                    <p class="mt-2 max-w-md text-sm leading-6 text-muted">{step.text}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="showcase-stage relative min-h-[500px] overflow-hidden rounded-[18px] border border-border-strong bg-surface shadow-[0_24px_70px_rgb(0_0_0/0.1)]" aria-hidden="true">
              <div class="flex h-11 items-center justify-between border-b border-border px-4">
                <span class="font-mono text-[10px] text-subtle">JOBFLOW / APPLICATION ASSISTANT</span>
                <span class="flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-success"></span>local</span>
              </div>

              <div class="showcase-panel" data-showcase-panel="detect" data-active="true">
                <div class="p-6 sm:p-8">
                  <div class="flex items-center justify-between border-b border-border pb-5">
                    <div><p class="text-sm font-semibold text-ink">Application detected</p><p class="mt-1 text-xs text-subtle">Senior Backend Engineer · Step 2 of 4</p></div>
                    <span class="rounded-md border border-border px-2 py-1 font-mono text-[10px] text-subtle">18 fields</span>
                  </div>
                  <div class="mt-6 grid gap-3 sm:grid-cols-2">
                    {['Personal details', 'Experience', 'Role questions', 'Documents'].map((label, index) => (
                      <div class="rounded-lg border border-border p-4">
                        <div class="flex items-center justify-between"><span class="text-sm font-medium text-ink">{label}</span><span class:list={['size-2 rounded-full', index < 2 ? 'bg-success' : index === 2 ? 'bg-warning' : 'bg-subtle']}></span></div>
                        <div class="mt-4 space-y-2" aria-hidden="true"><div class="h-2 w-3/4 rounded bg-accent-soft"></div><div class="h-2 w-1/2 rounded bg-accent-soft"></div></div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="review">
                <div class="p-6 sm:p-8">
                  <div class="border-b border-border pb-5"><p class="text-sm font-semibold text-ink">Review before fill</p><p class="mt-1 text-xs text-subtle">Three fields need your judgment.</p></div>
                  <div class="mt-5 divide-y divide-border border-y border-border">
                    <div class="grid grid-cols-[1fr_auto] gap-4 py-4"><div><p class="text-sm font-medium text-ink">Current role</p><p class="mt-1 text-xs text-muted">Two saved values could match this question.</p></div><span class="font-mono text-[10px] text-warning">REVIEW</span></div>
                    <div class="grid grid-cols-[1fr_auto] gap-4 py-4"><div><p class="text-sm font-medium text-ink">Visa sponsorship</p><p class="mt-1 text-xs text-muted">Sensitive disclosure stays outside normal fill.</p></div><span class="font-mono text-[10px] text-subtle">SENSITIVE</span></div>
                    <div class="grid grid-cols-[1fr_auto] gap-4 py-4"><div><p class="text-sm font-medium text-ink">Why this company?</p><p class="mt-1 text-xs text-muted">No trusted reusable answer exists yet.</p></div><span class="font-mono text-[10px] text-muted">UNKNOWN</span></div>
                  </div>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="fill">
                <div class="p-6 sm:p-8">
                  <div class="flex items-center justify-between border-b border-border pb-5"><div><p class="text-sm font-semibold text-ink">Safe fill plan</p><p class="mt-1 text-xs text-subtle">Only deterministic ready fields are included.</p></div><span class="font-mono text-lg font-semibold text-ink">14</span></div>
                  <div class="mt-6 space-y-3">
                    {['First name', 'Last name', 'Email', 'Phone', 'LinkedIn'].map((label) => (
                      <div class="flex items-center justify-between rounded-md border border-border px-3 py-2.5"><span class="text-sm text-muted">{label}</span><span class="flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-success"></span>ready</span></div>
                    ))}
                  </div>
                  <div class="mt-5 flex justify-end"><span class="rounded-md bg-accent px-3 py-2 text-xs font-medium text-background">Fill 14 safe fields</span></div>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="track">
                <div class="p-6 sm:p-8">
                  <div class="border-b border-border pb-5"><p class="text-sm font-semibold text-ink">Current opportunity</p><p class="mt-1 text-xs text-subtle">Saved only when you ask Jobflow to keep it.</p></div>
                  <div class="mt-6 rounded-lg border border-border-strong p-5">
                    <div class="flex items-start justify-between gap-4"><div><p class="text-base font-semibold text-ink">Senior Backend Engineer</p><p class="mt-1 text-sm text-muted">Example Company · Remote</p></div><span class="rounded-md border border-border px-2 py-1 font-mono text-[10px] text-subtle">READY</span></div>
                    <div class="mt-6 grid grid-cols-3 divide-x divide-border border-y border-border py-3 text-center"><div><p class="font-mono text-xs text-subtle">SOURCE</p><p class="mt-1 text-xs text-ink">Current page</p></div><div><p class="font-mono text-xs text-subtle">STATUS</p><p class="mt-1 text-xs text-ink">Saved</p></div><div><p class="font-mono text-xs text-subtle">SUBMIT</p><p class="mt-1 text-xs text-ink">You</p></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="capabilities" class="border-b border-border bg-surface">
      <div class="mx-auto max-w-[1200px] px-5 py-20 lg:px-7 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.62fr_1.38fr]" data-reveal>
          <div>
            <p class="font-mono text-xs text-subtle">FOUR CORE SURFACES</p>
            <h2 class="mt-4 max-w-[10ch] text-3xl font-semibold tracking-[-0.04em] text-ink">The product, not a feature wall.</h2>
          </div>
          <div class="grid border-t border-border sm:grid-cols-2">
            {capabilityRows.map((item, index) => (
              <article class:list={['min-h-[190px] border-b border-border p-5 sm:p-6', index % 2 === 0 && 'sm:border-r']}>
                <div class="flex items-start justify-between gap-4"><h3 class="text-base font-semibold text-ink">{item.title}</h3><span class="font-mono text-[10px] text-subtle">0{index + 1}</span></div>
                <p class="mt-7 font-mono text-[11px] text-subtle">{item.meta}</p>
                <p class="mt-3 text-sm leading-6 text-muted">{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-20 lg:grid-cols-2 lg:px-7 lg:py-24" data-reveal>
        <div>
          <p class="font-mono text-xs text-subtle">WORKS TODAY</p>
          <div class="mt-5 divide-y divide-border border-y border-border">
            {worksToday.map((item) => <div class="flex items-center gap-3 py-3.5 text-sm text-ink"><span class="size-1.5 rounded-full bg-success"></span>{item}</div>)}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-subtle">INTENTIONALLY NOT SUPPORTED</p>
