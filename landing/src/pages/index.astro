---
import BaseLayout from '../layouts/BaseLayout.astro';

const productDelta = [
  ['Retype experience on every portal', 'Reuse one career profile'],
  ['Copy answers between applications', 'Review prepared answers'],
  ['Remember which document to upload', 'Use stored document recommendations'],
  ['Track roles in a separate tool', 'Save the current role to a local pipeline'],
];

const capabilities = [
  'Chromium desktop',
  'Native and ATS-shaped application forms',
  'Dynamic and multi-step forms',
  'PDF, DOCX, and TXT CV import',
  'Resume, cover letter, portfolio, transcript, and certificate fields',
  'Reusable answer memory',
  'Encrypted sensitive-data vault',
  'Local application pipeline',
];

const limitations = [
  'No auto-submit',
  'No auto-next',
  'No cloud profile',
  'No AI dependency',
  'No image-only PDF extraction',
];

const dataPath = [
  ['Career profile', 'Local extension storage'],
  ['Documents', 'Local IndexedDB'],
  ['Sensitive values', 'Encrypted local vault'],
  ['Application page', 'Analyzed locally'],
  ['AI API', 'None'],
  ['Cloud backend', 'None'],
  ['Submit / Next', 'Never clicked'],
];
---

<BaseLayout
  title="Jobflow — Stop retyping every job application"
  description="Keep one reusable career profile, review what Jobflow detects, and fill only what you approve. Local-first, no account, no auto-submit."
>
  <header class="sticky top-0 z-50 border-b border-border bg-background">
    <div class="mx-auto flex h-14 max-w-[1120px] items-center justify-between px-5 lg:px-6">
      <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-[-0.02em] text-ink" aria-label="Jobflow home">
        <span class="grid size-8 place-items-center rounded-md bg-accent text-sm font-bold text-background">J</span>
        <span>Jobflow</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Primary navigation">
        <a class="hover:text-ink" href="#workflow">Workflow</a>
        <a class="hover:text-ink" href="#support">Support</a>
        <a class="hover:text-ink" href="#trust">Privacy</a>
      </nav>

      <a
        class="inline-flex h-9 items-center justify-center rounded-md border border-border-strong px-3.5 text-sm font-medium text-ink hover:border-ink"
        href="https://github.com/howlil/jobflow"
        target="_blank"
        rel="noreferrer"
      >
        GitHub <span aria-hidden="true" class="ml-1.5">↗</span>
      </a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="mx-auto grid max-w-[1120px] gap-12 px-5 pb-16 pt-16 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:px-6 lg:pb-20 lg:pt-20">
      <div>
        <p class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Local-first job application workspace</p>
        <h1 class="max-w-[13ch] text-[clamp(2.5rem,5vw,3.35rem)] font-semibold leading-[1.02] tracking-[-0.05em] text-ink">
          Stop retyping every job application.
        </h1>
        <p class="mt-5 max-w-[600px] text-[17px] leading-7 text-muted">
          Keep one reusable career profile. Jobflow prepares safe fields for the application you are on, flags what needs review, and never submits for you.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a class="inline-flex h-9 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-background hover:bg-accent-strong" href="#install">
            Build & install Jobflow
          </a>
          <a
            class="inline-flex h-9 items-center justify-center rounded-md border border-border-strong px-4 text-sm font-medium text-ink hover:border-ink"
            href="https://github.com/howlil/jobflow"
            target="_blank"
            rel="noreferrer"
          >
            View source <span aria-hidden="true" class="ml-1.5">↗</span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs text-subtle" aria-label="Product boundaries">
          <span>Local-first</span>
          <span>No account</span>
          <span>No auto-submit</span>
          <span>No AI dependency</span>
        </div>
      </div>

      <div class="border border-border-strong bg-surface" aria-label="Jobflow product state preview">
        <div class="flex min-h-11 items-center justify-between border-b border-border px-4 py-2">
          <div>
            <p class="text-sm font-semibold text-ink">Backend Engineer</p>
            <p class="mt-0.5 font-mono text-xs text-subtle">jobs.example.com/apply</p>
          </div>
          <span class="font-mono text-xs text-subtle">Application form</span>
        </div>

        <div class="grid min-h-[430px] lg:grid-cols-[1fr_360px]">
          <div class="border-b border-border p-5 lg:border-b-0 lg:border-r lg:p-6" aria-hidden="true">
            <div class="max-w-[360px] space-y-4">
              <div>
                <div class="mb-1.5 h-2.5 w-20 rounded-sm bg-accent-soft"></div>
                <div class="h-9 rounded-md border border-border"></div>
              </div>
              <div>
                <div class="mb-1.5 h-2.5 w-28 rounded-sm bg-accent-soft"></div>
                <div class="h-9 rounded-md border border-border"></div>
              </div>
              <div>
                <div class="mb-1.5 h-2.5 w-24 rounded-sm bg-accent-soft"></div>
                <div class="h-9 rounded-md border border-border"></div>
              </div>
              <div>
                <div class="mb-1.5 h-2.5 w-32 rounded-sm bg-accent-soft"></div>
                <div class="h-24 rounded-md border border-border"></div>
              </div>
            </div>
          </div>

          <div class="bg-surface-raised">
            <div class="flex h-11 items-center justify-between border-b border-border px-4">
              <div class="flex items-center gap-2">
                <span class="size-2 rounded-full bg-success"></span>
                <span class="text-sm font-semibold text-ink">Jobflow</span>
              </div>
              <span class="font-mono text-xs text-subtle">18 detected</span>
            </div>

            <div class="grid grid-cols-3 border-b border-border text-center text-xs font-medium">
              <span class="border-r border-border bg-surface-muted px-2 py-2.5 text-ink">Autofill</span>
              <span class="border-r border-border px-2 py-2.5 text-muted">Pipeline</span>
              <span class="px-2 py-2.5 text-muted">Sensitive</span>
            </div>

            <div class="p-4">
              <div class="border-b border-border pb-3">
                <p class="text-sm font-medium text-ink">Application Profile</p>
                <p class="mt-0.5 text-xs text-subtle">Base profile · recommended</p>
              </div>

              <div class="grid grid-cols-3 divide-x divide-border border-b border-border py-4 text-center">
                <div>
                  <p class="font-mono text-lg font-semibold text-ink">14</p>
                  <p class="mt-0.5 text-xs text-subtle">Ready</p>
                </div>
                <div>
                  <p class="font-mono text-lg font-semibold text-warning">3</p>
                  <p class="mt-0.5 text-xs text-subtle">Review</p>
                </div>
                <div>
                  <p class="font-mono text-lg font-semibold text-muted">1</p>
                  <p class="mt-0.5 text-xs text-subtle">Sensitive</p>
                </div>
              </div>

              <div class="space-y-3 pt-4">
                <div class="grid grid-cols-[20px_1fr] gap-2 text-xs leading-5 text-muted">
                  <span class="font-mono text-subtle">1</span>
                  <span>Detect the current application form.</span>
                </div>
                <div class="grid grid-cols-[20px_1fr] gap-2 text-xs leading-5 text-muted">
                  <span class="font-mono text-subtle">2</span>
                  <span>Review uncertain or sensitive fields.</span>
                </div>
                <div class="grid grid-cols-[20px_1fr] gap-2 text-xs leading-5 text-muted">
                  <span class="font-mono text-subtle">3</span>
                  <span>Fill only approved values.</span>
                </div>
              </div>

              <button type="button" class="mt-4 h-9 w-full rounded-md bg-accent px-3 text-sm font-medium text-background">
                Fill 14 safe fields
              </button>
              <p class="mt-2 text-center text-xs text-subtle">Unknown fields stay untouched.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-border">
      <div class="mx-auto max-w-[1120px] px-5 py-14 lg:px-6 lg:py-16">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
          <div>
            <h2 class="max-w-[12ch] text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">The repetitive work Jobflow removes.</h2>
            <p class="mt-4 max-w-md text-sm leading-6 text-muted">The goal is not autonomous applying. It is removing repeated data entry while keeping judgment and submission with you.</p>
          </div>

          <div class="border-t border-border">
            {productDelta.map(([before, after]) => (
              <div class="grid gap-2 border-b border-border py-4 sm:grid-cols-[1fr_28px_1fr] sm:items-center">
                <p class="text-sm text-muted">{before}</p>
                <span class="hidden text-center text-subtle sm:block" aria-hidden="true">→</span>
                <p class="text-sm font-medium text-ink">{after}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="workflow" class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Workflow</p>
          <h2 class="mt-3 max-w-[12ch] text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">Set up once. Reuse it on every application.</h2>
        </div>

        <div>
          <div class="border-y border-border py-5">
            <p class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-subtle">Set up once</p>
            <h3 class="mt-2 text-base font-semibold text-ink">Build your career profile</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Experience, education, projects, documents, reusable answers, preferences, and role-specific Application Profiles stay reusable on-device.</p>
          </div>

          <div class="py-6">
            <p class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-subtle">Every application</p>
            <div class="mt-4 grid gap-px border border-border bg-border sm:grid-cols-6">
              {['Open', 'Detect', 'Review', 'Fill', 'Submit yourself', 'Track'].map((step, index) => (
                <div class="bg-background px-3 py-4">
                  <p class="font-mono text-xs text-subtle">0{index + 1}</p>
                  <p class="mt-1.5 text-sm font-medium text-ink">{step}</p>
                </div>
              ))}
            </div>
            <p class="mt-4 text-sm leading-6 text-muted">Jobflow can prepare and fill approved fields. The employer site remains the owner of Submit, Apply, and Next.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="support" class="border-y border-border bg-surface">
      <div class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-2">
          <div>
            <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Works today</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">Capabilities you can inspect in the repository.</h2>
            <div class="mt-7 border-t border-border">
              {capabilities.map((capability) => (
                <div class="flex items-center gap-3 border-b border-border py-3.5 text-sm text-ink">
                  <span class="size-1.5 shrink-0 rounded-full bg-success" aria-hidden="true"></span>
                  <span>{capability}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Intentionally not supported</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">Boundaries are part of the product.</h2>
            <div class="mt-7 border-t border-border">
              {limitations.map((limitation) => (
                <div class="flex items-center gap-3 border-b border-border py-3.5 text-sm text-muted">
                  <span class="font-mono text-xs text-subtle" aria-hidden="true">—</span>
                  <span>{limitation}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="trust" class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Privacy boundary</p>
          <h2 class="mt-3 max-w-[13ch] text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">Your career data does not need a backend.</h2>
          <p class="mt-4 max-w-md text-sm leading-6 text-muted">Jobflow's trust model is implemented as storage and execution boundaries, not as an abstract privacy promise.</p>
          <a
            class="mt-5 inline-flex text-sm font-medium text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink"
            href="https://github.com/howlil/jobflow/blob/master/docs/privacy.md"
            target="_blank"
            rel="noreferrer"
          >
            Read the privacy model ↗
          </a>
        </div>

        <div class="border-y border-border font-mono text-xs">
          {dataPath.map(([subject, behavior]) => (
            <div class="grid grid-cols-[1fr_auto] gap-5 border-b border-border px-1 py-3.5 last:border-b-0 sm:px-4">
              <span class="text-muted">{subject}</span>
              <span class="text-right text-ink">{behavior}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="install" class="border-y border-border bg-surface">
      <div class="mx-auto grid max-w-[1120px] gap-10 px-5 py-16 lg:grid-cols-[0.82fr_1.18fr] lg:px-6 lg:py-20">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle">Built in the open</p>
          <h2 class="mt-3 max-w-[12ch] text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">Inspect it. Build it. Change it.</h2>
          <p class="mt-4 max-w-md text-sm leading-6 text-muted">The source is public. Review the matcher, local persistence, vault boundaries, permissions, architecture, and compatibility strategy directly.</p>
        </div>

        <div>
          <div class="border border-border-strong bg-background font-mono text-xs text-ink">
            <div class="border-b border-border px-4 py-3 text-subtle">Build the Chromium extension</div>
            <pre class="overflow-x-auto p-4 leading-6"><code>git clone https://github.com/howlil/jobflow.git
cd jobflow
pnpm install --frozen-lockfile
pnpm build</code></pre>
          </div>
          <p class="mt-3 text-sm leading-6 text-muted">Then load <code class="font-mono text-xs text-ink">.output/chrome-mv3</code> through <code class="font-mono text-xs text-ink">chrome://extensions</code> in Developer mode.</p>

          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm">
            <a class="font-medium text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink" href="https://github.com/howlil/jobflow" target="_blank" rel="noreferrer">Source ↗</a>
            <a class="font-medium text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink" href="https://github.com/howlil/jobflow/blob/master/.agents/ARCHITECTURE.md" target="_blank" rel="noreferrer">Architecture ↗</a>
            <a class="font-medium text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink" href="https://github.com/howlil/jobflow/blob/master/docs/privacy.md" target="_blank" rel="noreferrer">Privacy ↗</a>
            <a class="font-medium text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink" href="https://github.com/howlil/jobflow/blob/master/docs/compatibility.md" target="_blank" rel="noreferrer">Compatibility ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto flex max-w-[1120px] flex-col gap-5 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-6 lg:py-16">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.035em] text-ink">Stop retyping the next application.</h2>
        <p class="mt-2 text-sm text-muted">Build Jobflow locally and keep submission under your control.</p>
      </div>
      <a class="inline-flex h-9 shrink-0 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-background hover:bg-accent-strong" href="#install">
        Build Jobflow
      </a>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class="mx-auto flex max-w-[1120px] flex-col gap-3 px-5 py-6 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between lg:px-6">
      <span>Jobflow · Local-first career application operations</span>
      <a class="hover:text-ink" href="https://github.com/howlil/jobflow" target="_blank" rel="noreferrer">github.com/howlil/jobflow ↗</a>
    </div>
  </footer>
</BaseLayout>
