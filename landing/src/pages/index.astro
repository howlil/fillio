---
import KineticGrid from '../components/ui/KineticGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const productDelta = [
  ['Retype experience on every form', 'Reuse one career profile'],
  ['Copy answers between applications', 'Review prepared reusable answers'],
  ['Remember which document fits the role', 'Use local document recommendations'],
  ['Track opportunities somewhere else', 'Save the current job to a local pipeline'],
];

const showcaseSteps = [
  {
    id: 'detect',
    number: '01',
    title: 'Detect the application',
    text: 'Jobflow recognizes supported application forms and classifies the fields on the page before anything is written.',
  },
  {
    id: 'review',
    number: '02',
    title: 'Review what needs judgment',
    text: 'Ready, ambiguous, unknown, and sensitive fields stay visibly separated so uncertainty never disappears behind automation.',
  },
  {
    id: 'fill',
    number: '03',
    title: 'Fill ready fields',
    text: 'One explicit action writes only the ready fields. Unknown and sensitive fields remain untouched until you decide otherwise.',
  },
  {
    id: 'track',
    number: '04',
    title: 'Keep the opportunity',
    text: 'Save the role to the local pipeline and mark it applied only after you submit on the employer site.',
  },
];

const pageCapabilities = [
  ['Autofill', 'Analyze the current page, review uncertain mappings, fill ready fields, and attach recommended documents explicitly.'],
  ['Pipeline', 'Review and save the exact job you are applying to without leaving the application page.'],
  ['Sensitive', 'Unlock encrypted values separately and approve disclosure for the current site before sensitive fill.'],
];

const workspaceCapabilities = [
  ['Career profile', 'Keep reusable experience, education, projects, preferences, links, and contact data in one place.'],
  ['Application Profiles', 'Maintain lightweight role-specific variants and let the deterministic recommender choose from page context.'],
  ['Documents', 'Store CVs and supporting files locally for explicit recommendation and attachment.'],
  ['Autofill Memory', 'Inspect, delete, reset, or reuse remembered mappings and stable answers.'],
];

const worksToday = [
  'Chromium desktop',
  'Native and ATS-shaped forms',
  'Dynamic and multi-step forms',
  'PDF, DOCX, and TXT CV import',
  'Resume, cover letter, portfolio, transcript, and certificate fields',
  'Reusable answers and Autofill Memory',
  'Encrypted sensitive-data vault',
  'Local application pipeline',
];

const intentionallyNotSupported = [
  'Auto-submit or auto-next',
  'Cloud career profile',
  'AI dependency for core matching',
  'Image-only PDF extraction',
  'Guessing unknown or ambiguous fields',
];

const dataPaths = [
  ['Career profile', 'Local extension storage'],
  ['Documents', 'Extension-owned IndexedDB'],
  ['Sensitive values', 'Encrypted local vault'],
  ['Application page', 'Analyzed locally'],
  ['AI API', 'None'],
  ['Cloud backend', 'None'],
  ['Submit / Next', 'Never clicked'],
];
---

<BaseLayout
  title="Jobflow — Stop retyping job applications"
  description="Keep one local career profile, review what Jobflow detects, fill only ready fields, and submit job applications yourself."
>
  <header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm">
    <div class="mx-auto flex h-14 max-w-[1120px] items-center justify-between px-5 lg:px-6">
      <a href="#top" class="flex items-center gap-2.5 text-sm font-semibold tracking-[-0.02em] text-ink" aria-label="Jobflow home">
        <span class="grid size-8 place-items-center rounded-md border border-border-strong bg-ink text-xs font-bold text-background">J</span>
        <span>Jobflow</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Primary navigation">
        <a class="transition-colors duration-150 hover:text-ink" href="#showcase">Workflow</a>
        <a class="transition-colors duration-150 hover:text-ink" href="#capabilities">Product</a>
        <a class="transition-colors duration-150 hover:text-ink" href="#trust">Privacy</a>
      </nav>

      <a
        class="landing-action inline-flex h-9 items-center justify-center rounded-md border border-border-strong px-3.5 text-sm font-medium text-ink"
        href="https://github.com/howlil/jobflow"
        target="_blank"
        rel="noreferrer"
      >
        GitHub <span aria-hidden="true" class="ml-1.5">↗</span>
      </a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="relative overflow-hidden border-b border-border" data-kinetic-surface>
      <KineticGrid />
      <div class="relative z-10 mx-auto grid min-h-[660px] max-w-[1120px] gap-12 px-5 py-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-6 lg:py-20">
        <div>
          <p class="hero-enter mb-4 font-mono text-xs font-medium uppercase tracking-[0.12em] text-subtle" style="--hero-delay: 40ms">
            Local-first job application workspace
          </p>
          <h1 class="hero-enter max-w-[11ch] text-[clamp(2.85rem,5.6vw,4.65rem)] font-semibold leading-[0.94] tracking-[-0.055em] text-ink" style="--hero-delay: 90ms">
            Stop retyping every job application.
          </h1>
          <p class="hero-enter mt-6 max-w-[560px] text-[16px] leading-7 text-muted" style="--hero-delay: 150ms">
            Keep one reusable career profile. Jobflow prepares the current application, shows what needs review, fills only ready fields when you ask, and never submits for you.
          </p>

          <div class="hero-enter mt-7 flex flex-wrap items-center gap-3" style="--hero-delay: 210ms">
            <a
              class="landing-action inline-flex h-10 items-center justify-center rounded-md bg-accent px-4 text-sm font-medium text-background"
              href="https://github.com/howlil/jobflow#local-development"
              target="_blank"
              rel="noreferrer"
            >
              Build locally <span aria-hidden="true" class="ml-1.5">↗</span>
            </a>
            <a
              class="landing-action inline-flex h-10 items-center justify-center rounded-md border border-border-strong px-4 text-sm font-medium text-ink"
              href="#showcase"
            >
              See the workflow
            </a>
          </div>

          <div class="hero-enter mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-subtle" style="--hero-delay: 250ms">
            <span>Local-first</span>
            <span>No account</span>
            <span>No auto-submit</span>
            <span>No AI dependency</span>
          </div>
        </div>

        <div class="hero-enter lg:pl-2" style="--hero-delay: 130ms">
          <div class="product-stage" aria-label="Faithful Jobflow assistant preview">
            <div class="flex h-11 items-center justify-between border-b border-border px-4">
              <div class="flex items-center gap-2" aria-hidden="true">
                <span class="size-2.5 rounded-full border border-border-strong"></span>
                <span class="size-2.5 rounded-full border border-border-strong"></span>
                <span class="size-2.5 rounded-full border border-border-strong"></span>
              </div>
              <span class="font-mono text-[11px] text-subtle">jobs.example.com/apply/backend-engineer</span>
              <span class="w-[48px]"></span>
            </div>

            <div class="relative min-h-[500px] overflow-hidden p-5 sm:p-6" aria-hidden="true">
              <div class="max-w-[58%]">
                <p class="text-sm font-semibold text-ink">Backend Engineer</p>
                <p class="mt-1 text-xs text-subtle">Application form</p>
                <div class="mt-6 space-y-4">
                  {[24, 32, 28, 36].map((width, index) => (
                    <div>
                      <div class="mb-2 flex items-center justify-between">
                        <div class="h-2.5 rounded-sm bg-accent-soft" style={`width:${width}%`}></div>
                        <span class:list={['size-1.5 rounded-full', index < 2 ? 'bg-success' : index === 2 ? 'bg-warning' : 'bg-subtle']}></span>
                      </div>
                      <div class:list={['rounded-md border border-border bg-surface', index === 3 ? 'h-24' : 'h-9']}></div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="absolute bottom-5 right-4 w-[min(380px,calc(100%-2rem))] overflow-hidden rounded-lg border border-border-strong bg-surface-raised shadow-[0_12px_32px_rgb(0_0_0/0.12)] sm:right-5">
                <div class="flex items-start justify-between border-b border-border px-4 py-3">
                  <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">Job Flow</p>
                    <p class="mt-1 text-sm font-semibold text-ink">Backend profile</p>
                    <p class="mt-0.5 text-[11px] text-subtle">jobs.example.com</p>
                  </div>
                  <span class="font-mono text-[10px] text-subtle">×</span>
                </div>

                <div class="grid grid-cols-3 border-b border-border text-center text-xs font-medium">
                  <span class="border-r border-border bg-surface-muted px-2 py-2.5 text-ink">Autofill <small class="ml-1 font-mono text-[9px]">3</small></span>
                  <span class="border-r border-border px-2 py-2.5 text-muted">Pipeline</span>
                  <span class="px-2 py-2.5 text-muted">Sensitive <small class="ml-1 font-mono text-[9px]">1</small></span>
                </div>

                <div class="p-4">
                  <div class="border-b border-border pb-3">
                    <p class="text-xs font-medium text-ink">Application profile</p>
                    <div class="mt-2 rounded-md border border-border px-3 py-2 text-xs text-muted">Automatic</div>
                    <p class="mt-1.5 text-[11px] leading-4 text-subtle">Automatic recommendation: Backend profile.</p>
                  </div>

                  <div class="py-3">
                    <strong class="text-sm text-ink">14 ready</strong>
                    <p class="mt-0.5 text-[11px] text-subtle">3 review · 1 sensitive</p>
                  </div>

                  <span class="flex h-9 items-center justify-center rounded-md bg-accent px-3 text-xs font-medium text-background">Fill 14 ready fields</span>

                  <div class="mt-3 border-t border-border pt-3">
                    <p class="text-xs font-medium text-ink">Needs attention</p>
                    <div class="mt-2 flex items-center justify-between text-xs text-muted"><span>Review reusable fields</span><strong class="font-mono text-ink">3</strong></div>
                    <div class="mt-2 flex items-center justify-between text-xs text-muted"><span>Sensitive fields</span><strong class="font-mono text-ink">1</strong></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1120px] divide-y divide-border px-5 lg:grid-cols-4 lg:divide-x lg:divide-y-0 lg:px-6">
        {['One profile', 'Explicit review', 'Local data', 'You submit'].map((label, index) => (
          <div class="flex items-center gap-3 py-4 lg:px-4 lg:first:pl-0">
            <span class="font-mono text-[10px] text-subtle">0{index + 1}</span>
            <span class="text-sm font-medium text-ink">{label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20" data-reveal>
      <div class="grid gap-9 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Product delta</p>
          <h2 class="mt-3 max-w-[12ch] text-3xl font-semibold tracking-[-0.035em] text-ink">Remove repetition. Keep judgment.</h2>
        </div>
        <div class="border-t border-border">
          {productDelta.map(([before, after]) => (
            <div class="grid gap-3 border-b border-border py-4 sm:grid-cols-[1fr_28px_1fr] sm:items-center sm:gap-4">
              <p class="text-sm leading-6 text-muted">{before}</p>
              <span class="hidden text-center font-mono text-xs text-subtle sm:block">→</span>
              <p class="text-sm font-medium leading-6 text-ink">{after}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-border bg-surface">
      <div class="mx-auto grid max-w-[1120px] gap-9 px-5 py-16 lg:grid-cols-2 lg:px-6 lg:py-20" data-reveal>
        <div class="border-t border-border pt-4">
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Set up once</span>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-ink">Build your reusable career context.</h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-muted">Experience, education, projects, documents, reusable answers, preferences, and Application Profiles live in one local workspace.</p>
        </div>
        <div class="border-t border-border pt-4">
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Every application</span>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-ink">Use the same controlled loop.</h2>
          <div class="mt-4 flex flex-wrap items-center gap-2 text-xs font-medium text-ink">
            {['Open', 'Detect', 'Review', 'Fill', 'Submit yourself', 'Track'].map((step, index, list) => (
              <>
                <span class="rounded-md border border-border-strong px-2.5 py-1.5">{step}</span>
                {index < list.length - 1 && <span class="font-mono text-subtle">→</span>}
              </>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="showcase" class="border-b border-border">
      <div class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20">
        <div class="mb-10 max-w-2xl" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Application workflow</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.035em] text-ink">The same assistant, four visible states.</h2>
          <p class="mt-4 text-[15px] leading-7 text-muted">Scroll through how Jobflow moves from page detection to explicit fill and local tracking. The shell stays stable; only the state changes.</p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]" data-showcase-root data-active-state="detect">
          <div>
            {showcaseSteps.map((step, index) => (
              <article
                class="showcase-step border-t border-border py-7 last:border-b"
                data-showcase-step={step.id}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <div class="flex items-start gap-4">
                  <span class="mt-1 font-mono text-xs text-subtle">{step.number}</span>
                  <div>
                    <h3 class="text-base font-semibold tracking-[-0.02em] text-ink">{step.title}</h3>
                    <p class="mt-2 max-w-md text-sm leading-6 text-muted">{step.text}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="showcase-stage relative min-h-[480px] overflow-hidden rounded-[10px] border border-border-strong bg-surface shadow-[0_12px_32px_rgb(0_0_0/0.08)]" aria-hidden="true">
              <div class="flex min-h-16 items-start justify-between border-b border-border px-4 py-3">
                <div>
                  <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">Job Flow</p>
                  <p class="mt-1 text-sm font-semibold text-ink">Application assistant</p>
                  <p class="mt-0.5 text-[11px] text-subtle">jobs.example.com</p>
                </div>
                <span class="font-mono text-[10px] text-subtle">×</span>
              </div>
              <div class="grid grid-cols-3 border-b border-border text-center text-xs font-medium">
                <span class="border-r border-border bg-surface-muted px-2 py-2.5 text-ink">Autofill</span>
                <span class="border-r border-border px-2 py-2.5 text-muted">Pipeline</span>
                <span class="px-2 py-2.5 text-muted">Sensitive</span>
              </div>

              <div class="showcase-panel" data-showcase-panel="detect" data-active="true">
                <div class="p-5 sm:p-6">
                  <p class="text-xs font-medium text-ink">Form analysis</p>
                  <div class="mt-3 border-y border-border">
                    <div class="flex items-center justify-between py-3 text-sm"><span class="text-muted">Ready</span><strong class="font-mono text-ink">14</strong></div>
                    <div class="flex items-center justify-between border-t border-border py-3 text-sm"><span class="text-muted">Needs review</span><strong class="font-mono text-warning">3</strong></div>
                    <div class="flex items-center justify-between border-t border-border py-3 text-sm"><span class="text-muted">Sensitive</span><strong class="font-mono text-ink">1</strong></div>
                  </div>
                  <p class="mt-4 text-xs leading-5 text-subtle">Nothing is written during analysis.</p>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="review">
                <div class="p-5 sm:p-6">
                  <p class="text-xs font-medium text-ink">Resolve ambiguous fields</p>
                  <div class="mt-3 divide-y divide-border border-y border-border">
                    <div class="py-4"><p class="text-sm font-medium text-ink">Current role</p><p class="mt-1 text-xs text-muted">Two saved values could match.</p><div class="mt-3 flex gap-2"><span class="rounded-md border border-border-strong px-2.5 py-1.5 text-xs text-ink">Professional headline</span><span class="rounded-md border border-border-strong px-2.5 py-1.5 text-xs text-ink">Ignore</span></div></div>
                    <div class="py-4"><p class="text-sm font-medium text-ink">Why this company?</p><p class="mt-1 text-xs text-muted">No trusted reusable answer exists yet.</p></div>
                  </div>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="fill">
                <div class="p-5 sm:p-6">
                  <strong class="text-sm text-ink">14 ready</strong>
                  <p class="mt-0.5 text-[11px] text-subtle">3 review · 1 sensitive</p>
                  <span class="mt-4 flex h-9 items-center justify-center rounded-md bg-accent px-3 text-xs font-medium text-background">Fill 14 ready fields</span>
                  <div class="mt-4 border-t border-border pt-4">
                    <p class="text-xs font-medium text-ink">After fill</p>
                    <p class="mt-2 text-xs leading-5 text-muted">Ready fields are written. Remaining review and sensitive items stay visible for manual action.</p>
                  </div>
                </div>
              </div>

              <div class="showcase-panel" data-showcase-panel="track">
                <div class="p-5 sm:p-6">
                  <p class="text-xs font-medium text-ink">Pipeline</p>
                  <h3 class="mt-2 text-lg font-semibold tracking-[-0.02em] text-ink">Review job details</h3>
                  <p class="mt-1 text-xs leading-5 text-muted">Confirm the job details before saving this local application.</p>
                  <div class="mt-4 space-y-3">
                    <div><p class="mb-1.5 text-[11px] text-subtle">Company</p><div class="h-9 rounded-md border border-border px-3 py-2 text-xs text-ink">Example Company</div></div>
                    <div><p class="mb-1.5 text-[11px] text-subtle">Role</p><div class="h-9 rounded-md border border-border px-3 py-2 text-xs text-ink">Backend Engineer</div></div>
                    <div><p class="mb-1.5 text-[11px] text-subtle">Stage</p><div class="h-9 rounded-md border border-border px-3 py-2 text-xs text-ink">Applying</div></div>
                  </div>
                  <span class="mt-4 flex h-9 items-center justify-center rounded-md bg-accent px-3 text-xs font-medium text-background">Save to pipeline</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="capabilities" class="border-b border-border bg-surface">
      <div class="mx-auto max-w-[1120px] px-5 py-16 lg:px-6 lg:py-20" data-reveal>
        <div class="mb-9 max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Product architecture</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.035em] text-ink">Application tools on the page. Career context in the workspace.</h2>
        </div>

        <div class="grid gap-9 lg:grid-cols-2">
          <div>
            <p class="border-b border-border pb-3 font-mono text-xs uppercase tracking-[0.08em] text-subtle">On the application page</p>
            <div>
              {pageCapabilities.map(([title, detail]) => (
                <article class="border-b border-border py-4">
                  <h3 class="text-sm font-semibold text-ink">{title}</h3>
                  <p class="mt-1.5 text-sm leading-6 text-muted">{detail}</p>
                </article>
              ))}
            </div>
          </div>
          <div>
            <p class="border-b border-border pb-3 font-mono text-xs uppercase tracking-[0.08em] text-subtle">In the workspace</p>
            <div>
              {workspaceCapabilities.map(([title, detail]) => (
                <article class="border-b border-border py-4">
                  <h3 class="text-sm font-semibold text-ink">{title}</h3>
                  <p class="mt-1.5 text-sm leading-6 text-muted">{detail}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1120px] gap-10 px-5 py-16 lg:grid-cols-2 lg:px-6 lg:py-20" data-reveal>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Works today</p>
          <div class="mt-4 divide-y divide-border border-y border-border">
            {worksToday.map((item) => <div class="flex items-center gap-3 py-3 text-sm text-ink"><span class="size-1.5 rounded-full bg-success"></span>{item}</div>)}
          </div>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Intentional boundaries</p>
          <div class="mt-4 divide-y divide-border border-y border-border">
            {intentionallyNotSupported.map((item) => <div class="flex items-center gap-3 py-3 text-sm text-muted"><span class="size-1.5 rounded-full border border-border-strong"></span>{item}</div>)}
          </div>
          <p class="mt-4 max-w-xl text-sm leading-6 text-muted">Jobflow removes repetitive entry without becoming an autonomous application bot.</p>
        </div>
      </div>
    </section>

    <section id="trust" class="border-b border-border bg-surface">
      <div class="mx-auto grid max-w-[1120px] gap-10 px-5 py-16 lg:grid-cols-[0.72fr_1.28fr] lg:px-6 lg:py-20" data-reveal>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Data & privacy</p>
          <h2 class="mt-3 max-w-[12ch] text-3xl font-semibold tracking-[-0.035em] text-ink">Your career data stays local.</h2>
          <p class="mt-4 max-w-md text-sm leading-6 text-muted">The privacy model is an implementation boundary: core matching and storage stay on-device, while submission remains outside the extension.</p>
        </div>
        <div class="border-t border-border font-mono text-xs">
          {dataPaths.map(([subject, value]) => (
            <div class="grid grid-cols-[1fr_auto] gap-6 border-b border-border py-3.5"><span class="text-muted">{subject}</span><span class="text-right text-ink">{value}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1120px] gap-10 px-5 py-16 lg:grid-cols-[0.82fr_1.18fr] lg:px-6 lg:py-20" data-reveal>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-subtle">Build & inspect</p>
          <h2 class="mt-3 max-w-[12ch] text-3xl font-semibold tracking-[-0.035em] text-ink">Build Jobflow locally today.</h2>
          <p class="mt-4 max-w-md text-sm leading-6 text-muted">There is no packaged public release yet. Build the verified Chromium extension from source and inspect the matcher, storage, privacy, and compatibility model directly.</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border-strong bg-surface shadow-[0_8px_24px_rgb(0_0_0/0.06)]">
          <div class="flex items-center justify-between border-b border-border px-4 py-3 font-mono text-[10px] text-subtle"><span>LOCAL BUILD</span><span>Chromium</span></div>
